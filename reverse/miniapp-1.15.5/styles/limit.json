    "transitionTimingFunction": "cubic-bezier(0.175,0.885,0.32,1.275)"
  },
  "@TRANSITION": {
    "startup-icon": {
      "property": "transform",
      "duration": 300,
      "timingFunction": "cubic-bezier(0.175,0.885,0.32,1.275)"
    },
    "h-app-item": {
      "property": "transform",
      "duration": 200,
      "timingFunction": "ease"
    },
    "lyric-wrapper": {
      "property": "transform",
      "duration": 400,
      "timingFunction": "ease-in-out"
    },
    "lyric-line": {
      "property": "color,fontSize",
      "duration": 300
    },
    "queue-overlay": {
      "property": "backgroundColor",
      "duration": 300
    },
    "queue-drawer": {
      "property": "transform",
      "duration": 300,
      "timingFunction": "ease-out"
    },
    "chaty-popup-card": {
      "property": "width,height,borderRadius,padding",
      "duration": 300,
      "timingFunction": "ease-in-out"
    },
    "cp-btn": {
      "property": "backgroundColor,transform",
      "duration": 200
    },
    "pl-overlay": {
      "property": "backgroundColor",
      "duration": 300
    },
    "pl-drawer": {
      "property": "transform",
