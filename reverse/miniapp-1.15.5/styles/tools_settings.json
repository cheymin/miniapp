    "paddingBottom": "3px",
    "paddingLeft": "7px",
    "paddingRight": "7px",
    "borderRadius": "12px"
  },
  "badge-text-orange": {
    "fontSize": "11px",
    "color": "#ff9f0a",
    "fontWeight": "bold"
  },
  "toggle": {
    "width": "40px",
    "height": "22px",
    "borderRadius": "12px",
    "justifyContent": "center",
    "paddingTop": "2px",
    "paddingRight": "2px",
    "paddingBottom": "2px",
    "paddingLeft": "2px",
    "transitionProperty": "backgroundColor",
    "transitionDuration": 200
  },
  "@TRANSITION": {
    "toggle": {
      "property": "backgroundColor",
      "duration": 200
    },
    "toggle-thumb": {
      "property": "transform",
      "duration": 200
    }
  },
  "toggle-thumb": {
    "width": "18px",
    "height": "18px",
    "borderRadius": "8px",
    "backgroundColor": "#ffffff",
    "transitionProperty": "transform",
    "transitionDuration": 200
  },
