  "main-content": {
    "paddingTop": "18px",
    "paddingRight": "18px",
    "paddingBottom": "36px",
    "paddingLeft": "9px"
  },
  "page": {
    "flexDirection": "column"
  },
  "section-title": {
    "fontSize": "13px",
    "color": "#c7c7cc",
    "marginLeft": "12px",
    "marginBottom": "8px",
    "marginTop": "8px"
