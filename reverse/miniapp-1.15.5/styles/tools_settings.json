    "paddingRight": "10px",
    "height": "28px",
    "borderRadius": "8px",
    "backgroundColor": "#2c2c2e",
    "justifyContent": "center",
    "alignItems": "center",
    "borderWidth": "1px",
    "borderColor": "rgba(255,255,255,0.08)"
