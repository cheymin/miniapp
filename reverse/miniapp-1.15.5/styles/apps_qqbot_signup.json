{
  "page": {
    "flex": 1,
    "backgroundColor": "#1c1c1e",
    "paddingTop": "16px",
    "paddingRight": "20px",
    "paddingBottom": "16px",
    "paddingLeft": "20px",
    "color": "#f3f4f6"
  },
  "top": {
    "flexDirection": "row",
    "alignItems": "center",
    "justifyContent": "space-between",
    "height": "44px"
  },
  "top-actions": {
    "flexDirection": "row",
    "alignItems": "center"
  },
  "title": {
    "color": "#f3f4f6",
    "fontSize": "20px",
    "fontWeight": "bold"
  },
  "top-btn": {
    "height": "30px",
    "paddingLeft": "12px",
    "paddingRight": "12px",
    "borderRadius": "8px",
    "backgroundColor": "#2c2c2e",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "top-btn-txt": {
    "color": "#f3f4f6",
    "fontSize": "12px"
  },
  "body": {
    "flex": 1,
    "minHeight": 0,
    "paddingTop": "8px"
  },
  "card": {
    "paddingTop": "16px",
    "paddingRight": "16px",
    "paddingBottom": "16px",
    "paddingLeft": "16px",
    "borderRadius": "14px",
    "backgroundColor": "#2c2c2e"
  },
  "card-title": {
    "color": "#ffffff",
    "fontSize": "18px",
    "fontWeight": "bold"
  },
  "card-sub": {
    "marginTop": "6px",
    "color": "#c7c7cc",
    "fontSize": "12px",
    "lineHeight": "18px"
  },
  "field": {
    "marginTop": "12px",
    "paddingTop": "10px",
    "paddingRight": "12px",
    "paddingBottom": "10px",
    "paddingLeft": "12px",
    "borderRadius": "10px",
    "backgroundColor": "#000000"
  },
  "field-label": {
    "color": "#c7c7cc",
    "fontSize": "11px"
  },
  "field-value": {
    "marginTop": "4px",
    "color": "#ffffff",
    "fontSize": "13px"
  },
  "field-placeholder": {
    "marginTop": "4px",
    "color": "#636366",
    "fontSize": "13px"
  },
  "row": {
    "flexDirection": "row",
    "marginTop": "14px"
  },
  "btn": {
    "height": "34px",
    "marginRight": "8px",
    "paddingLeft": "14px",
    "paddingRight": "14px",
    "borderRadius": "9px",
    "backgroundColor": "#3a3a3c",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "btn-primary": {
    "backgroundColor": "#0a84ff"
  },
  "btn-txt": {
    "color": "#ffffff",
    "fontSize": "13px",
    "fontWeight": "1\"600\""
  },
  "info-warn": {
    "marginTop": "10px",
    "color": "#ff9f0a",
    "fontSize": "12px",
    "lineHeight": "17px"
  },
  "hint": {
    "marginTop": "10px",
    "color": "#c7c7cc",
    "fontSize": "11px",
    "lineHeight": "16px"
  },
  "btn-press": {
    "opacity": 0.75
  },
  "top-btn-press": {
    "opacity": 0.65
  },
  "field-press": {
    "opacity": 0.75
  },
  "page-l": {
    "backgroundColor": "#f2f2f7",
    "color": "#3a3a3c"
  },
  "title-l": {
    "color": "#3a3a3c"
  },
  "top-btn-l": {
    "backgroundColor": "#ffffff"
  },
  "top-btn-txt-l": {
    "color": "#3a3a3c"
