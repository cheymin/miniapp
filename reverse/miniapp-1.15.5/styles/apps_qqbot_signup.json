    "color": "#1c1c1e"
  },
  "card-sub-l": {
    "color": "#636366"
  },
  "field-l": {
    "backgroundColor": "#ffffff"
  },
  "field-label-l": {
    "color": "#636366"
  },
  "field-value-l": {
    "color": "#1c1c1e"
  },
  "field-placeholder-l": {
    "color": "#aeaeb2"
  },
  "btn-l": {
    "backgroundColor": "#ffffff"
  },
  "btn-primary-l": {
    "backgroundColor": "#007aff"
  },
  "btn-txt-l": {
    "color": "#1c1c1e"
  },
  "info-warn-l": {
    "color": "#ff9500"
  },
  "hint-l": {
    "color": "#636366"
  }
