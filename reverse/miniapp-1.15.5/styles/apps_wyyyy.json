  "queue-modal-overlay": {
    "position": "absolute",
    "top": 0,
    "left": 0,
    "right": 0,
    "bottom": 0,
    "backgroundColor": "rgba(0,0,0,0)",
    "justifyContent": "center",
    "alignItems": "center",
    "transitionProperty": "backgroundColor",
    "transitionDuration": 300
  },
  "@TRANSITION": {
    "queue-modal-overlay": {
      "property": "backgroundColor",
      "duration": 300
    },
    "queue-drawer": {
      "property": "transform",
      "duration": 300,
      "timingFunction": "ease-out"
    }
  },
  "queue-modal-overlay-show": {
    "backgroundColor": "rgba(0,0,0,0.85)"
  },
  "queue-drawer": {
    "position": "absolute",
    "top": 0,
    "right": 0,
    "bottom": 0,
    "width": "320px",
    "height": "100%",
    "backgroundColor": "#12161f",
    "paddingTop": "16px",
    "paddingRight": "14px",
    "paddingBottom": "12px",
    "paddingLeft": "14px",
    "borderLeftWidth": "1px",
    "borderLeftColor": "rgba(255,255,255,0.06)",
    "transform": "translateX(320px)",
    "transitionProperty": "transform",
    "transitionDuration": 300,
    "transitionTimingFunction": "ease-out"
  },
  "queue-drawer-show": {
    "transform": "translateX(0)"
  },
