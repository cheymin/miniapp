{
  "app": {
    "width": "100%",
    "height": "100%",
    "backgroundColor": "#09090b",
    "flexDirection": "row"
  },
  "sidebar": {
    "width": "68px",
    "backgroundColor": "#000000",
    "borderRightWidth": "1px",
    "borderRightColor": "#39393d",
    "alignItems": "center",
    "paddingTop": "16px",
    "paddingBottom": "16px"
  },
  "sb-btn": {
    "width": "44px",
    "height": "44px",
    "borderRadius": "12px",
    "justifyContent": "center",
    "alignItems": "center",
    "marginBottom": "8px"
  },
  "sb-search": {
    "backgroundColor": "#ffffff"
  },
  "sb-source": {
    "backgroundColor": "#1c1c1e"
  },
  "sb-src-xv": {
    "borderWidth": "1px",
    "borderColor": "rgba(220,38,38,0.2)"
  },
  "sb-src-wv": {
    "borderWidth": "1px",
    "borderColor": "rgba(22,163,74,0.2)"
  },
  "sb-src-ph": {
    "borderWidth": "1px",
    "borderColor": "rgba(249,115,22,0.2)"
  },
  "sb-src-ma": {
    "borderWidth": "1px",
    "borderColor": "rgba(168,85,247,0.2)"
  },
  "sb-back": {
    "backgroundColor": "#1c1c1e"
  },
  "sb-txt": {
    "fontSize": "13px",
    "fontWeight": "bold"
  },
  "sb-txt-dark": {
    "color": "#09090b"
  },
  "sb-txt-red": {
    "color": "#ff453a"
  },
  "sb-txt-green": {
    "color": "#34c759"
  },
  "sb-txt-orange": {
    "color": "#ff9f0a"
  },
  "sb-txt-purple": {
    "color": "#a855f7"
  },
  "sb-txt-blue": {
    "color": "#0a84ff"
  },
  "sb-spacer": {
    "flex": 1
  },
  "sb-dot": {
    "width": "8px",
    "height": "8px",
    "borderRadius": "4px",
    "marginBottom": "8px"
  },
  "content": {
    "flex": 1
  },
  "empty-state": {
    "flex": 1,
    "justifyContent": "center",
    "alignItems": "center"
  },
  "empty-icon": {
    "fontSize": "48px",
    "marginBottom": "12px"
  },
  "empty-text": {
    "fontSize": "15px",
    "fontWeight": "bold",
    "color": "#39393d",
    "marginBottom": "8px"
  },
  "empty-sub": {
    "fontSize": "11px",
    "color": "#3a3a3c"
  },
  "main-view": {
    "flex": 1,
    "flexDirection": "row"
  },
  "player-panel": {
    "width": 0,
    "flex": 1,
    "borderRightWidth": "1px",
    "borderRightColor": "#39393d",
    "backgroundColor": "#0c0c0e"
  },
  "player-wrap": {
    "width": "100%",
    "height": "259px",
    "backgroundColor": "#1c1c1e",
    "position": "relative"
  },
  "player-thumb": {
    "width": "100%",
    "height": "259px"
  },
  "player-overlay": {
    "position": "absolute",
    "left": 0,
    "top": 0,
    "width": "100%",
    "height": "259px",
    "justifyContent": "center",
    "alignItems": "center",
    "backgroundColor": "rgba(0,0,0,0.35)"
  },
  "play-circle": {
    "width": "68px",
    "height": "68px",
    "borderRadius": "34px",
    "backgroundColor": "rgba(255,255,255,0.15)",
    "borderWidth": "2px",
    "borderColor": "rgba(255,255,255,0.35)",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "play-icon": {
    "color": "#ffffff",
    "fontSize": "26px",
    "marginLeft": "4px"
  },
  "player-info": {
    "paddingTop": "18px",
    "paddingRight": "18px",
    "paddingBottom": "18px",
    "paddingLeft": "18px"
  },
  "player-title": {
    "fontSize": "15px",
    "fontWeight": "bold",
    "color": "#ffffff",
    "lines": "<expr>",
    "textOverflow": "ellipsis",
    "lineHeight": "22px",
    "marginBottom": "12px"
  },
  "player-meta": {
    "flexDirection": "row"
  },
  "meta-tag": {
    "paddingLeft": "10px",
    "paddingRight": "10px",
    "paddingTop": "4px",
    "paddingBottom": "4px",
    "borderRadius": "8px",
    "backgroundColor": "#1c1c1e",
    "marginRight": "8px"
  },
  "meta-txt": {
    "fontSize": "11px",
    "fontWeight": "bold",
    "color": "#f3f4f6"
  },
  "grid-panel": {
    "flex": 1.25,
    "paddingTop": "16px",
    "paddingRight": "16px",
    "paddingBottom": "16px",
    "paddingLeft": "16px"
  },
  "grid-row": {
    "flexDirection": "row",
    "marginBottom": "12px",
    "justifyContent": "flex-start"
  },
  "card": {
    "width": 0,
    "flexGrow": 1,
    "flexShrink": 1,
    "backgroundColor": "#000000",
    "borderRadius": "8px",
    "marginRight": "12px",
    "overflow": "hidden",
    "borderWidth": "1px",
    "borderColor": "#1a1a1e"
  },
  "card-last": {
    "marginRight": 0
  },
  "card-thumb-wrap": {
    "width": "100%",
    "height": "120px",
    "backgroundColor": "#1c1c1e",
    "position": "relative"
  },
  "card-thumb": {
    "width": "100%",
    "height": "120px"
  },
  "card-dur-wrap": {
    "position": "absolute",
    "right": "6px",
    "bottom": "6px",
    "backgroundColor": "rgba(0,0,0,0.85)",
    "paddingLeft": "6px",
    "paddingRight": "6px",
    "paddingTop": "2px",
    "paddingBottom": "2px",
    "borderRadius": "4px"
  },
  "card-dur": {
    "color": "#ffffff",
    "fontSize": "11px",
    "fontWeight": "bold"
  },
  "card-quality-wrap": {
    "position": "absolute",
    "left": "6px",
    "top": "6px",
    "backgroundColor": "rgba(239,68,68,0.9)",
    "paddingLeft": "5px",
    "paddingRight": "5px",
    "paddingTop": "1px",
    "paddingBottom": "1px",
    "borderRadius": "4px"
  },
  "card-quality": {
    "color": "#ffffff",
    "fontSize": "11px",
    "fontWeight": "bold"
  },
  "card-body": {
    "paddingTop": "10px",
    "paddingRight": "10px",
    "paddingBottom": "10px",
    "paddingLeft": "10px",
    "height": "50px",
    "justifyContent": "center"
  },
  "card-title": {
    "fontSize": "11px",
    "fontWeight": "1\"600\"",
    "color": "#f3f4f6",
    "lines": 2,
    "textOverflow": "ellipsis",
    "lineHeight": "16px"
  },
  "sb-btn-press": {
    "opacity": 0.65
  },
  "sb-search-press": {
    "opacity": 0.65
  },
  "sb-source-press": {
    "opacity": 0.65
  },
  "sb-back-press": {
    "opacity": 0.65
  },
  "player-wrap-press": {
    "opacity": 0.65
  },
  "card-press": {
    "opacity": 0.65
  },
  "app-l": {
    "backgroundColor": "#f4f4f6"
  },
  "sidebar-l": {
    "backgroundColor": "#ffffff",
    "color": "#c6c6c8"
  },
  "sb-search-l": {
    "backgroundColor": "#1c1c1e"
  },
  "sb-source-l": {
    "backgroundColor": "#ffffff"
  },
  "sb-src-xv-l": {
    "color": "rgba(220,38,38,0.2)"
  },
  "sb-src-wv-l": {
    "color": "rgba(22,163,74,0.2)"
  },
  "sb-src-ph-l": {
    "color": "rgba(249,115,22,0.2)"
  },
  "sb-src-ma-l": {
    "color": "rgba(168,85,247,0.2)"
  },
  "sb-back-l": {
    "backgroundColor": "#ffffff"
  },
  "sb-txt-dark-l": {
    "color": "#f4f4f6"
  },
  "sb-txt-red-l": {
    "color": "#ff3b30"
  },
  "sb-txt-green-l": {
    "color": "#34c759"
  },
  "sb-txt-orange-l": {
    "color": "#ff9500"
  },
  "sb-txt-purple-l": {
    "color": "#0a0113"
  },
  "sb-txt-blue-l": {
    "color": "#007aff"
  },
  "empty-text-l": {
    "color": "#c6c6c8"
  },
  "empty-sub-l": {
    "color": "#ffffff"
  },
  "player-panel-l": {
    "color": "#c6c6c8",
    "backgroundColor": "#f4f4f6"
  },
  "player-wrap-l": {
    "backgroundColor": "#ffffff"
  },
  "player-overlay-l": {
    "backgroundColor": "rgba(0,0,0,0.35)"
  },
  "play-circle-l": {
    "backgroundColor": "rgba(255,255,255,0.22)",
    "color": "rgba(255,255,255,0.85)"
  },
  "player-title-l": {
    "color": "#1c1c1e"
  },
  "meta-tag-l": {
    "backgroundColor": "#ffffff"
  },
  "meta-txt-l": {
    "color": "#3a3a3c"
  },
  "card-l": {
    "backgroundColor": "#ffffff",
    "color": "#e9e9ec"
  },
  "card-thumb-wrap-l": {
    "backgroundColor": "#f2f2f7"
  },
  "card-dur-wrap-l": {
    "backgroundColor": "rgba(0,0,0,0.85)"
  },
  "card-dur-l": {
    "color": "#1c1c1e"
  },
  "card-quality-wrap-l": {
    "backgroundColor": "rgba(239,68,68,0.9)"
  },
  "card-quality-l": {
    "color": "#1c1c1e"
  },
  "card-title-l": {
    "color": "#3a3a3c"
  }
}