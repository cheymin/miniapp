  "form-btn-primary": {
    "backgroundColor": "#0a84ff"
  },
  "form-btn-secondary": {
    "backgroundColor": "#3a3a3c",
    "marginRight": "10px"
  },
  "form-btn-txt": {
    "color": "#ffffff",
    "fontSize": "14px",
    "fontWeight": "1\"600\""
  },
  "form-status-text": {
    "color": "#ff9f0a",
    "fontSize": "12px",
    "marginTop": "10px"
  },
  "result-card": {
    "marginTop": "14px",
    "backgroundColor": "#22262b",
    "borderRadius": "12px",
    "paddingTop": "16px",
    "paddingRight": "16px",
    "paddingBottom": "16px",
    "paddingLeft": "16px"
  },
  "result-title": {
    "color": "#34c759",
    "fontSize": "15px",
    "fontWeight": "1\"700\"",
    "marginBottom": "10px"
  },
  "result-row": {
    "flexDirection": "row",
    "justifyContent": "space-between",
    "alignItems": "center",
    "paddingTop": "6px",
    "paddingBottom": "6px"
  },
  "result-label": {
    "color": "#c7c7cc",
    "fontSize": "12px",
    "marginRight": "12px"
  },
  "result-value": {
    "color": "#f3f4f6",
    "fontSize": "12px",
    "fontWeight": "1\"600\"",
    "flex": 1,
    "textAlign": "right",
    "flexWrap": "wrap"
  },
  "status-line": {
    "flexDirection": "row",
    "alignItems": "center",
    "paddingTop": "6px",
    "paddingBottom": "6px"
  },
  "dot": {
    "width": "10px",
    "height": "10px",
    "borderRadius": "5px",
    "marginRight": "8px"
  },
  "dot-green": {
    "backgroundColor": "#34c759"
  },
  "dot-red": {
    "backgroundColor": "#ff453a"
  },
  "status-line-txt": {
    "color": "#f3f4f6",
    "fontSize": "12px",
    "fontWeight": "1\"500\""
  },
  "result-actions": {
    "flexDirection": "row",
    "marginTop": "8px"
  },
  "foot-note": {
    "paddingTop": "14px",
    "paddingBottom": "24px",
    "alignItems": "center"
  },
  "foot-note-txt": {
    "color": "#5a606b",
    "fontSize": "11px"
  },
  "header-back-press": {
