{
  "panel-page": {
    "width": "100%",
    "height": "100%",
    "backgroundColor": "#2c2c2e",
    "flexDirection": "column"
  },
  "panel-header": {
    "height": "52px",
    "backgroundColor": "#22262b",
    "flexDirection": "row",
    "alignItems": "center",
    "paddingLeft": "14px",
    "paddingRight": "14px",
    "borderBottomWidth": "1px",
    "borderBottomColor": "#39393d"
  },
  "header-back": {
    "flexDirection": "row",
    "alignItems": "center",
    "width": "110px"
  },
  "header-back-icon": {
    "color": "#0a84ff",
    "fontSize": "26px",
    "marginRight": "4px",
    "lineHeight": "28px"
  },
  "header-back-txt": {
    "color": "#0a84ff",
    "fontSize": "14px",
    "fontWeight": "1\"600\""
  },
  "header-title": {
    "flex": 1,
    "textAlign": "center",
    "color": "#f3f4f6",
    "fontSize": "16px",
    "fontWeight": "1\"700\""
  },
  "header-right": {
    "width": "110px",
    "flexDirection": "row",
    "justifyContent": "flex-end"
  },
  "header-link": {
    "paddingTop": "6px",
    "paddingBottom": "6px",
    "paddingLeft": "8px",
    "paddingRight": "8px",
    "backgroundColor": "#2c2c2e",
    "borderRadius": "6px"
  },
  "header-link-txt": {
    "color": "#0a84ff",
    "fontSize": "12px",
    "fontWeight": "1\"600\""
  },
  "info-card": {
    "paddingTop": "14px",
    "paddingRight": "14px",
    "paddingBottom": "14px",
    "paddingLeft": "14px",
    "borderRadius": "12px",
    "backgroundColor": "#2c2c2e"
  },
  "info-row": {
    "flexDirection": "row",
    "justifyContent": "space-between",
    "marginTop": "6px"
  },
  "info-label": {
    "color": "#c7c7cc",
    "fontSize": "12px"
  },
  "info-value": {
    "color": "#f3f4f6",
    "fontSize": "12px"
  },
  "notice": {
    "marginTop": "10px",
    "color": "#ff9f0a",
    "fontSize": "12px",
    "lineHeight": "17px"
  },
  "btn-row": {
    "flexDirection": "row",
    "marginTop": "12px",
    "flexWrap": "wrap"
  },
  "list-card": {
    "marginTop": "8px",
    "paddingTop": "12px",
    "paddingRight": "14px",
    "paddingBottom": "12px",
    "paddingLeft": "14px",
    "borderRadius": "10px",
    "backgroundColor": "#2c2c2e"
  },
  "list-row": {
    "flexDirection": "row",
    "justifyContent": "space-between"
  },
  "list-label": {
    "color": "#f3f4f6",
    "fontSize": "13px"
  },
  "list-value": {
    "color": "#34c759",
    "fontSize": "12px"
  },
  "list-sub": {
    "marginTop": "4px",
    "color": "#c7c7cc",
    "fontSize": "11px"
  },
  "panel-tabs": {
    "height": "42px",
    "backgroundColor": "#1d1f23",
    "flexDirection": "row",
    "alignItems": "center",
    "paddingLeft": "16px",
    "paddingRight": "16px"
  },
  "ptab": {
    "height": "30px",
    "paddingLeft": "20px",
    "paddingRight": "20px",
    "marginRight": "8px",
    "borderRadius": "15px",
    "justifyContent": "center",
    "alignItems": "center",
    "backgroundColor": "rgba(0,0,0,0)"
  },
  "ptab-active": {
    "backgroundColor": "#0a84ff"
  },
  "ptab-txt": {
    "color": "#c7c7cc",
    "fontSize": "14px",
    "fontWeight": "1\"600\""
  },
  "ptab-txt-active": {
    "color": "#ffffff"
  },
  "panel-scroll": {
    "flex": 1,
    "minHeight": 0
  },
  "tab-body": {
    "paddingTop": "18px",
    "paddingRight": "18px",
    "paddingBottom": "8px",
    "paddingLeft": "18px"
  },
  "section-title": {
    "color": "#f3f4f6",
    "fontSize": "15px",
    "fontWeight": "1\"700\"",
    "marginBottom": "12px"
  },
  "plan-row": {
    "flexDirection": "row"
  },
  "plan-card": {
    "flex": 1,
    "backgroundColor": "#22262b",
    "borderRadius": "12px",
    "paddingTop": "16px",
    "paddingRight": "16px",
    "paddingBottom": "16px",
    "paddingLeft": "16px",
    "marginRight": "12px"
  },
  "plan-card-last": {
    "marginRight": 0
  },
  "plan-name": {
    "color": "#f3f4f6",
    "fontSize": "16px",
    "fontWeight": "1\"700\"",
    "marginBottom": "6px"
  },
  "plan-price": {
    "color": "#0a84ff",
    "fontSize": "13px",
    "fontWeight": "1\"600\"",
    "marginBottom": "8px"
  },
  "plan-desc": {
    "color": "#c7c7cc",
    "fontSize": "12px",
    "lineHeight": "18px",
    "flexWrap": "wrap",
    "marginBottom": "14px",
    "height": "54px"
  },
  "plan-btn": {
    "height": "34px",
    "backgroundColor": "#0a84ff",
    "borderRadius": "8px",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "plan-btn-txt": {
    "color": "#ffffff",
    "fontSize": "13px",
    "fontWeight": "1\"600\""
  },
  "help-box": {
    "marginTop": "20px",
    "backgroundColor": "#1d1f23",
    "borderRadius": "10px",
    "paddingTop": "14px",
    "paddingRight": "14px",
    "paddingBottom": "14px",
    "paddingLeft": "14px"
  },
  "help-title": {
    "color": "#f3f4f6",
    "fontSize": "13px",
    "fontWeight": "1\"700\"",
    "marginBottom": "8px"
