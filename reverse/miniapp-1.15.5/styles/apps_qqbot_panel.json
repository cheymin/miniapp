  "help-line": {
    "color": "#c7c7cc",
    "fontSize": "12px",
    "lineHeight": "19px",
    "flexWrap": "wrap"
  },
  "act-card": {
    "backgroundColor": "#22262b",
    "borderRadius": "12px",
    "paddingTop": "16px",
    "paddingRight": "16px",
    "paddingBottom": "16px",
    "paddingLeft": "16px"
  },
  "form-label": {
