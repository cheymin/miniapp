  "form-input": {
    "height": "36px",
    "backgroundColor": "#2c2c2e",
    "borderRadius": "8px",
    "justifyContent": "center",
    "paddingLeft": "12px",
    "paddingRight": "12px"
  },
  "form-input-txt": {
    "color": "#f3f4f6",
    "fontSize": "13px",
    "lines": 1,
    "textOverflow": "ellipsis"
  },
  "form-row": {
    "flexDirection": "row",
    "marginTop": "10px"
  },
  "form-btn": {
    "height": "36px",
    "borderRadius": "8px",
    "justifyContent": "center",
    "alignItems": "center",
    "marginTop": "12px"
