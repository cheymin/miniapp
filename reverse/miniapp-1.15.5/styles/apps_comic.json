{
  "container": {
    "width": "100vw",
    "height": "100vh",
    "backgroundColor": "#080a0c",
    "flexDirection": "row"
  },
  "button-col": {
    "width": "31vh",
    "alignItems": "center",
    "paddingTop": "8vh"
  },
  "icon-btn": {
    "width": "22vh",
    "height": "22vh",
    "borderRadius": "6vh",
    "justifyContent": "center",
    "alignItems": "center",
    "marginBottom": "5vh",
    "backgroundColor": "#1c1c1e"
  },
  "active": {
    "backgroundColor": "#ffffff"
  },
  "icon-img": {
    "width": "10vh",
    "height": "10vh"
  },
  "icon-label": {
    "fontSize": "4.2vh",
    "color": "#c7c7cc",
    "marginTop": "2vh"
  },
  "icon-label-active": {
    "color": "#1c1c1e",
    "fontWeight": "1\"500\""
  },
  "main-scroll": {
    "flex": 1
  },
  "page-title": {
    "marginTop": "10vh",
    "marginBottom": "8vh",
    "color": "#8e918f",
