  "panel": {
    "width": "85%",
    "maxWidth": "600px",
    "backgroundColor": "#1c1c1e",
    "borderRadius": "6vh",
    "paddingTop": "8vh",
    "paddingRight": "8vh",
    "paddingBottom": "8vh",
    "paddingLeft": "8vh"
