  },
  "empty-text": {
    "color": "#636366",
    "fontSize": "14px"
  },
  "content-grid": {
    "flexDirection": "row",
    "flexWrap": "wrap"
  },
  "comic-card": {
    "marginTop": 0,
    "marginRight": "3vh",
    "marginBottom": "3vh",
    "marginLeft": 0,
    "backgroundColor": "#1c1c1e",
    "borderRadius": "4vh",
    "overflow": "hidden"
  },
  "comic-card-press": {
    "opacity": 0.7
  },
  "card-cover": {
    "width": "100%",
    "flex": 1,
    "backgroundColor": "#2c2c2e"
