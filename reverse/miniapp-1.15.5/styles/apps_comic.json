    "marginBottom": "1.5vh"
  },
  "card-author": {
    "color": "#c7c7cc",
    "fontSize": "3vh"
  },
  "overlay": {
    "position": "absolute",
    "top": 0,
    "left": 0,
    "width": "100%",
    "height": "100%",
    "backgroundColor": "rgba(0,0,0,0.88)",
    "zIndex": 999,
    "justifyContent": "center",
    "alignItems": "center"
