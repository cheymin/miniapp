{
  "page": {
    "flex": 1,
    "backgroundColor": "#101014",
    "flexDirection": "column"
  },
  "topbar": {
    "flexDirection": "row",
    "alignItems": "center",
    "justifyContent": "space-between",
    "paddingTop": "10px",
    "paddingRight": "20px",
    "paddingBottom": "6px",
    "paddingLeft": "20px"
  },
  "title-box": {
    "flexDirection": "row"
  },
  "title": {
    "color": "#f2f0fa",
    "fontSize": "22px",
    "fontWeight": "bold",
    "marginRight": "12px"
  },
  "subtitle": {
    "color": "#8e8ea0",
    "fontSize": "13px"
  },
  "top-actions": {
    "flexDirection": "row",
    "alignItems": "center"
  },
  "chip": {
    "backgroundColor": "#23232c",
    "borderRadius": "12px",
    "paddingTop": "6px",
    "paddingRight": "12px",
    "paddingBottom": "6px",
    "paddingLeft": "12px",
    "marginLeft": "8px",
    "backgroundColor:active": "#32323e"
  },
  "chip-txt": {
    "color": "#cfcbe8",
    "fontSize": "12px"
  },
  "chip-danger": {
    "backgroundColor": "#3a2028",
    "backgroundColor:active": "#4d2833"
  },
  "hero": {
    "backgroundColor": "#1a1a22",
    "borderRadius": "12px",
    "marginTop": "4px",
    "marginRight": "20px",
    "marginBottom": "8px",
    "marginLeft": "20px",
    "paddingTop": "8px",
    "paddingRight": "16px",
    "paddingBottom": "8px",
    "paddingLeft": "16px",
    "height": "44px",
    "justifyContent": "center"
  },
  "hero-row": {
    "flexDirection": "row",
    "alignItems": "center"
  },
  "hero-tag": {
    "color": "#8e8ea0",
    "fontSize": "13px",
    "marginRight": "10px"
  },
  "hero-subject": {
    "fontSize": "22px",
    "fontWeight": "bold",
    "marginRight": "14px"
  },
  "hero-time": {
    "color": "#dcd8f0",
    "fontSize": "14px",
    "marginRight": "12px"
  },
  "hero-count": {
    "color": "#f5b50a",
    "fontSize": "13px"
  },
  "hero-after": {
    "color": "#6a6a7a",
    "fontSize": "12px",
    "marginLeft": "12px"
  },
  "hero-empty": {
    "color": "#8e8ea0",
    "fontSize": "14px"
  },
  "grid-scroll": {
    "flex": 1
  },
  "grid": {
    "flexDirection": "column",
    "paddingTop": 0,
    "paddingRight": "20px",
    "paddingBottom": "8px",
    "paddingLeft": "20px"
  },
  "grid-row": {
    "flexDirection": "row",
    "marginBottom": "5px"
  },
  "grid-head": {
    "marginBottom": "4px"
  },
  "cell": {
    "height": "42px",
    "marginRight": "5px",
    "borderRadius": "10px",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "cell-corner": {
    "width": "96px",
    "backgroundColor": "rgba(0,0,0,0)"
  },
  "corner-txt": {
    "color": "#8e8ea0",
    "fontSize": "12px"
  },
  "cell-day": {
    "flex": 1,
    "backgroundColor": "#1a1a22"
  },
  "day-txt": {
    "color": "#9a96b0",
    "fontSize": "13px"
  },
  "cell-day-today": {
    "backgroundColor": "#2c2350"
  },
  "day-txt-today": {
    "color": "#c4b5fd",
    "fontWeight": "bold"
  },
  "cell-period": {
    "width": "96px",
    "backgroundColor": "#1a1a22",
    "flexDirection": "row",
    "alignItems": "center"
  },
  "period-no": {
    "color": "#e8e6f4",
    "fontSize": "16px",
    "fontWeight": "bold",
    "marginRight": "6px"
  },
  "period-time": {
    "color": "#6a6a7a",
    "fontSize": "10px"
  },
  "cell-subject": {
    "flex": 1,
    "backgroundColor": "#17171f",
    "backgroundColor:active": "#26262f"
  },
  "cell-today-col": {
    "backgroundColor": "#211d38"
  },
  "cell-now-row": {
    "borderWidth": "1px",
    "borderColor": "#f5b50a"
  },
  "subject-txt": {
    "color": "#ffffff",
    "fontSize": "13px",
    "fontWeight": "bold"
  },
  "subject-empty": {
    "color": "#3a3a44",
    "fontSize": "15px"
  },
  "modal-mask": {
    "position": "absolute",
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0,
    "backgroundColor": "rgba(0,0,0,0.7)",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "modal-card": {
    "width": "520px",
    "backgroundColor": "#1e1e28",
    "borderRadius": "18px",
    "paddingTop": "20px",
    "paddingRight": "24px",
    "paddingBottom": "20px",
    "paddingLeft": "24px"
  },
  "modal-title": {
    "color": "#f2f0fa",
    "fontSize": "18px",
    "fontWeight": "bold",
    "marginBottom": "10px"
  },
  "modal-desc": {
    "color": "#9a96b0",
    "fontSize": "13px",
    "marginBottom": "18px"
  },
  "modal-actions": {
    "flexDirection": "row",
    "justifyContent": "flex-end"
  },
  "modal-btn": {
    "fontSize": "14px",
    "paddingTop": "8px",
    "paddingRight": "20px",
    "paddingBottom": "8px",
    "paddingLeft": "20px",
    "borderRadius": "12px",
    "marginLeft": "10px"
  },
  "modal-cancel": {
    "color": "#9a96b0",
    "backgroundColor": "#2a2a36"
  },
  "modal-ok": {
    "color": "#ffffff",
    "backgroundColor": "#d04a4a"
  },
  "chip-ai": {
    "backgroundColor": "#2c2350",
    "backgroundColor:active": "#3a2f66"
  },
  "ai-mask": {
    "position": "absolute",
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0,
    "backgroundColor": "rgba(0,0,0,0.7)",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "ai-card": {
    "width": "640px",
    "backgroundColor": "#1e1e28",
    "borderRadius": "18px",
    "paddingTop": "22px",
    "paddingRight": "26px",
    "paddingBottom": "22px",
    "paddingLeft": "26px"
  },
  "ai-title": {
    "color": "#f2f0fa",
    "fontSize": "18px",
    "fontWeight": "bold",
    "marginBottom": "8px"
  },
  "ai-desc": {
    "color": "#9a96b0",
    "fontSize": "12px",
    "marginBottom": "14px",
    "lineHeight": "18px"
  },
  "ai-thumbs": {
    "flexDirection": "row",
    "flexWrap": "wrap",
    "alignItems": "center",
    "marginBottom": "12px"
  },
  "ai-thumb-box": {
    "width": "84px",
    "height": "84px",
    "marginTop": 0,
    "marginRight": "10px",
    "marginBottom": "10px",
    "marginLeft": 0
  },
  "ai-thumb": {
    "width": "84px",
    "height": "84px",
    "borderRadius": "10px"
  },
  "ai-thumb-x": {
    "position": "absolute",
    "right": "-7px",
    "top": "-7px",
    "width": "26px",
    "height": "26px",
    "borderRadius": "13px",
    "backgroundColor": "#d04a4a",
    "justifyContent": "center",
    "alignItems": "center"
  },
  "ai-thumb-x-txt": {
    "color": "#ffffff",
    "fontSize": "14px",
    "fontWeight": "bold"
  },
  "ai-add": {
    "width": "84px",
    "height": "84px",
    "borderRadius": "10px",
    "borderWidth": "1px",
    "borderColor": "#4a4a5a",
    "justifyContent": "center",
    "alignItems": "center",
    "marginTop": 0,
    "marginRight": "10px",
    "marginBottom": "10px",
    "marginLeft": 0,
    "backgroundColor:active": "#2a2a36"
  },
  "ai-add-txt": {
    "color": "#9a96b0",
    "fontSize": "12px"
  },
  "ai-status": {
    "color": "#f5b50a",
    "fontSize": "13px",
    "marginBottom": "12px"
  },
  "ai-actions": {
    "flexDirection": "row",
    "justifyContent": "flex-end"
  },
  "ai-btn": {
    "fontSize": "14px",
    "paddingTop": "8px",
    "paddingRight": "20px",
    "paddingBottom": "8px",
    "paddingLeft": "20px",
    "borderRadius": "12px",
    "marginLeft": "10px"
  },
  "ai-cancel": {
    "color": "#9a96b0",
    "backgroundColor": "#2a2a36"
  },
  "ai-go": {
    "color": "#ffffff",
    "backgroundColor": "#6d5ae0",
    "backgroundColor:active": "#7d6af0"
  },
  "toast": {
    "position": "absolute",
    "left": 0,
    "right": 0,
    "bottom": "60px",
    "alignItems": "center"
  },
  "toast-txt": {
    "color": "#ffffff",
    "backgroundColor": "#2c2c3a",
    "fontSize": "14px",
    "paddingTop": "10px",
    "paddingRight": "26px",
    "paddingBottom": "10px",
    "paddingLeft": "26px",
    "borderRadius": "16px"
  }
}