    },
    "queue-drawer": {
      "property": "transform",
      "duration": 300,
      "timingFunction": "ease-out"
    },
    "chaty-popup-card": {
      "property": "width,height,borderRadius,padding",
      "duration": 300,
      "timingFunction": "ease-in-out"
    },
    "pl-overlay": {
      "property": "backgroundColor",
      "duration": 300
    },
    "pl-drawer": {
      "property": "transform",
      "duration": 300,
      "timingFunction": "ease-out"
    }
